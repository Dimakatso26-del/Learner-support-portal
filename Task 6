const word = "code wars" //declare function as a string
console.log(word)

function acronym() {  //use function to create acronym
    let split = word.split(" ") //split the string into words by spaces
    console.log(split)
let first = split.map(word => word[0].toUpperCase()).join(" ") //take the first letter of each word, Uppercase each letter using toUpperCase(), and join them together with a space in between.
console.log(first)
}
acronym() //call the function


